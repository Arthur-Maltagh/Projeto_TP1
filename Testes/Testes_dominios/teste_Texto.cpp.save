#include <iostream>
#include <stdexcept>
#include "../../dominios/Texto.h"

using namespace std;

bool teste_Texto(){

    Texto texto;

    try {
        texto.setTexto("So sei que nada sei.");

        if(texto.getTexto() != "So sei que nada sei.")
            return false;

    } catch(const exception& e) {
        return false;
    }

    try {
        texto.setTexto("SABO DE TUDO,, E MAS UM Poco!!");


        return false;

    } catch(const invalid_argument&) {
        // exceção esperada
    }

    return true;
}
