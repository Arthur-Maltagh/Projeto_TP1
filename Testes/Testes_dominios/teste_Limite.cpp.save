#include <iostream>
#include <stdexcept>
#include "../dominios/Limite.h"

using namespace std;

bool teste_Limite(){

    Limite limite;

    // Caso de sucesso
    try{
        limite.setLimite(5);

        if(limite.getLimite() != 5)
            return false;
    }
    catch(const exception& e){
        return false;
    }

    // Caso inválido: deve lançar exceção
    try{
        limite.setLimite(67);

        // Se chegou aqui, a exceção não foi lançada
        return false;
    }
    catch(const invalid_argument& e){
        // comportamento esperado
    }

    return true;
}

