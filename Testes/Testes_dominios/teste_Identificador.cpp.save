#include <iostream>
#include <stdexcept>
#include "../../dominios/Identificador.h"

using namespace std;

bool teste_Identificador(){

    Identificador identificador;

    try {
        identificador.setIdentificador("Fla777");

        if(identificador.getIdentificador() != "Fla777")
            return false;

    } catch(const exception& e) {
        return false;
    }

    try {
        identificador.setIdentificador("666flu");
        return false;

    } catch(const invalid_argument&) {
        // exceção esperada
    }

    return true;
}

/*
6 caracteres
Sendo letras (a-z ou A-Z) os três primeiros caracteres.
Sendo dígitos (0-9) os três últimos caracteres.
*/
