#include <iostream>
#include <stdexcept>
#include "../../dominios/Senha.h"

using namespace std;

bool teste_Senha(){

    Senha senha;
    try{
        senha.setSenha("0nda5");

        if(senha.getSenha() != "0nda5")
            return false;
    }
    catch(const exception& e){
        return false;
    }
    try{
        senha.setSenha("SenhaSegura");
        return false;
    }
    catch(const invalid_argument& e){
        // exceção esperada
    }

    return true;
}

