#include <iostream>
#include <stdexcept>
#include "../../dominios/nome.h"

using namespace std;

bool teste_nome(){

    Nome nome;
    try{
        nome.setNome("Donald biden");

        if(nome.getNome() != "Donald biden")
            return false;
    }
    catch(const exception& e){
        return false;
    }
    try{
        nome.setNome("  Jorge Lafont dos santos");
        return false;
    }
    catch(const invalid_argument& e){
        // exceção esperada
    }

    return true;
}

